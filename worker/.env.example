# Public HTTPS origin of CostLens (not the Supabase URL).
APP_URL=
# Same server-only secret as the app; at least 32 random characters.
WORKER_SECRET=
# Speech-to-text provider. Gemini remains the cost-extraction provider in the app.
OPENAI_API_KEY=
PORT=3001

# Vercel gateway only: external Render processor origin. Not needed by the Render process itself.
WORKER_URL=
# WORKER_SERVICE_URL is injected only into the calling Next.js service; never set it here.
