# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
WORKER_URL=
WORKER_SECRET=

# Server-only AES-256 key: base64 encoding of 32 random bytes; needed only for saved online sources.
SOURCE_ENCRYPTION_KEY=

# Optional model overrides. Empty uses gemini-flash-lite-latest for both roles (override with a model available to your Google project).
GEMINI_MODEL_SMART=
GEMINI_MODEL_FAST=
# Only true behind a proxy that overwrites forwarded IP headers. Vercel is detected automatically.
TRUST_PROXY_HEADERS=

# Public origin of the deployed CostLens app; required by the separate media worker.
APP_URL=
