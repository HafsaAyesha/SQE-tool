# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
WORKER_URL=
WORKER_SECRET=

# Server-only AES-256 key: base64 encoding of 32 random bytes; needed only for saved online sources.
SOURCE_ENCRYPTION_KEY=

# Optional model overrides. Empty uses claude-sonnet-5-5 / claude-haiku-5-5.
ANTHROPIC_MODEL_SMART=
ANTHROPIC_MODEL_FAST=
# Only true behind a proxy that overwrites forwarded IP headers. Vercel is detected automatically.
TRUST_PROXY_HEADERS=
